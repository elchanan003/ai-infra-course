# Incident 4 - evidence. KEY=value, no spaces around '='. Every value comes from live signals of YOUR run; <...> placeholders are rejected.
MISSING_FILE=<file name that is missing from the snapshot>
BAD_FILE=<file name of the shard whose content is corrupt>
BAD_SHA=<first 12 hex characters of the sha256 of the corrupt file as you found it>
TRIPWIRE_HOST=<name the serving network tried to resolve>
TRIPWIRE_HITS=<DNS lookups the tripwire counted for the failed rollout, integer>
