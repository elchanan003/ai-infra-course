# Incident 3 - evidence. KEY=value, no spaces around '='. Every value comes from live signals of YOUR run; <...> placeholders are rejected.
AFFECTED_NODE=<a or b>
XID_CODE=<the XID error code on the sick GPU, integer>
GPU_UUID=<full GPU-... UUID of the sick GPU>
DRAIN_DECISION=<drain or wait>
TEMP_C=<GPU temperature of the sick GPU in degrees C, integer>
