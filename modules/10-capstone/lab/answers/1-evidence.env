# Incident 1 - evidence. KEY=value, no spaces around '='. Every value comes from live signals of YOUR run; <...> placeholders are rejected.
HEAVY_KEY_ALIAS=<alias of the key that sent the most requests>
TEAM_RPM_LIMIT=<requests per minute of the team quota, integer>
CHAT_429_COUNT=<429 responses the chat key received in the incident window, integer>
LIMIT_SCOPE=<per-replica or global: the scope at which the limit counters were kept>
