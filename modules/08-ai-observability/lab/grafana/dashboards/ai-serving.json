{
  "uid": "ai-serving",
  "title": "AI serving",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "tags": ["course"],
  "templating": {"list": [
    {"name": "model", "type": "query", "label": "model", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "query": {"query": "label_values(vllm:kv_cache_usage_perc, model_name)", "refId": "m"},
     "includeAll": true, "allValue": ".*", "multi": true, "current": {"selected": true, "text": "All", "value": "$__all"}, "refresh": 2}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "TTFT p95", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
                  "expr": "sum(vllm:time_to_first_token_seconds_sum{model_name=~\"$model\"}) / sum(vllm:time_to_first_token_seconds_count{model_name=~\"$model\"})",
                  "legendFormat": "p95"}]}
  ]
}
