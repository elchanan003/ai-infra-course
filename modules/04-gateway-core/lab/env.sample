# Given (do not change). Admin credentials of the lab gateway.
MASTER=sk-aiinfra-master
GATEWAY=http://127.0.0.1:18040
GATEWAY_REPLICA2=http://127.0.0.1:18041
# container-network names (use these inside config.yaml; localhost is the container itself):
#   llama chat   http://llama-chat:8080/v1      (served name: chat)
#   llama coder  http://llama-coder:8080/v1     (served name: coder)
#   llama embed  http://llama-embed:8080/v1     (served name: embed)
# Environment variables available inside the LiteLLM container:
#   LITELLM_MASTER_KEY  DATABASE_URL  LITELLM_SALT_KEY
