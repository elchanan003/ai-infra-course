# Incident 5 - evidence. KEY=value, no spaces around '='. Every value comes from live signals of YOUR run; <...> placeholders are rejected.
NODE_NAME=<node of the new pool>
TAINT_KEY=<key of the taint the pod does not tolerate>
WRONG_RESOURCE=<extended-resource name the node advertises instead of nvidia.com/gpu>
FIRST_REASON=<untolerated-taint, insufficient-gpu, node-selector-mismatch or unschedulable-node: the first scheduler reason>
SECOND_REASON=<same list: the reason that appears after you fixed the first>
GPU_CAPACITY_AFTER=<nvidia.com/gpu allocatable on that node after your fix, integer>
