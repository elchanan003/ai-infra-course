# Incident 2 - evidence. KEY=value, no spaces around '='. Every value comes from live signals of YOUR run; <...> placeholders are rejected.
KV_PEAK=<peak vllm:kv_cache_usage_perc in the incident window, percent>
PREEMPTIONS=<vllm:num_preemptions_total increase in the incident window, integer>
PEAK_WAITING=<peak vllm:num_requests_waiting in the incident window, integer>
PLANTED_MAX_NUM_SEQS=<the --max-num-seqs the release set, integer>
